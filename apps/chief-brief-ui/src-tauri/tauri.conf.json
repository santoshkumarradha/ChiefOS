{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morning Brief",
  "version": "0.1.0",
  "identifier": "com.chiefos.morning-brief",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Morning Brief",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "fullscreen": false,
        "backgroundColor": "#0c0e11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "fonts/*"
    ]
  }
}
