  "private": true,
  "type": "module",
  "description": "Chief OS React primitive kit: locked tokens and OS-feeling surface components.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
